    },
    {
     "sev": "HIGH",
     "loc": "app/services/task_service.py:451-478",
     "text": "_probe_video 调用 ffprobe 没有 timeout，也没有捕获 subprocess OSError、媒体读取异常或 stat 异常；get_task 默认 include_video_probe=True，损坏、卡死或不可达媒体可长期阻塞任务详情或直接 500。"
    },
    {
     "sev": "MED",
     "loc": "app/services/video_cut_workflow_service.py:18-45",
     "text": "_next_cut_run_number 先 SELECT MAX(run_number)，随后由独立连接 INSERT，缺少事务序列化或唯一约束；并发重切可能产生重复 run_number。"
    },
    {
     "sev": "MED",
     "loc": "app/services/task_lifecycle_service.py:66-71",
     "text": "allocate_task_dir_name 会先原子预占目录，再由 create_task_directory 和数据库 INSERT 继续执行；后续目录初始化或数据库提交失败时没有统一释放已预占的空目录，可能累积孤儿目录并影响后续命名。"
    },
    {
     "sev": "MED",
     "loc": "app/services/task_service.py:14-96",
     "text": "task_service 仍集中导入 AI、字幕、转写、存储、切片等大量私有服务函数，并与 task_lifecycle_service 形成动态反向依赖，职责边界复杂。"
    },
    {
     "sev": "MED",
     "loc": "app/services/task_query_service.py:89-172",
     "text": "_batch_all_output_clips 复制 task_service.list_output_clips 的路径解析、字幕状态和发布就绪判断；两套口径未来可能分叉。"
    },
    {
     "sev": "MED",
     "loc": "app/services/task_service.py:587-603",
     "text": "get_task 查询只按 id，不过滤 is_deleted；已永久删除且仅应保留历史的任务仍可被详情和后续动作读取。"

# NiuMa Studio 环境变量示例
# 使用方法：复制本文件为 .env，再填写自己的配置。
# .env 已被 Git 忽略；不要提交真实 API Key、Cookie、Token 或账号信息。

# ========================
# 基础配置
# ========================

# setup.ps1 会自动生成随机值。手动配置时请使用足够长的随机字符串。
LOCAL_ADMIN_TOKEN=

# Docker 宿主机上的视频存储目录。
# 相对路径以仓库根目录为基准；也可以使用 D:/NiuMaStudio/tasks 之类的绝对路径。
NIUMA_STORAGE_PATH=./workspace/tasks

# 本地 Python 运行时可留空，程序会使用仓库内的 data/ 与 workspace/tasks/。
# Docker Compose 会自动覆盖为容器内部路径。
DATA_DIR=
DATABASE_PATH=
STORAGE_ROOT=
TASKS_DIR=
UPLOAD_TEMP_DIR=

FFMPEG_TIMEOUT=600
# 普通 Workflow Job 连续多久没有进度或 checkpoint 更新后才终止，默认 30 分钟。
WORKFLOW_JOB_NO_PROGRESS_TIMEOUT_SECONDS=1800
APP_TIMEZONE=Asia/Shanghai

# ========================
# AI：文字稿分析与发布文案
# ========================

AI_DEFAULT_PROVIDER=codex
AI_PUBLISH_PROVIDER=codex
AI_CODEX_PATH=codex
AI_CODEX_HOME=
AI_CODEX_MODEL=gpt-6-astra
AI_CODEX_TIMEOUT_SECONDS=600
AI_REQUEST_TIMEOUT_SECONDS=120

# 当前仅使用 Codex；旧远程模型与 Ollama 配置不再需要。

# 完全离线，本地音频不会上传；不支持切换到云转写。
TRANSCRIPTION_PROVIDER=local
TRANSCRIPTION_FALLBACK_PROVIDER=
TRANSCRIPTION_OFFLINE_ONLY=true
TRANSCRIPTION_MODEL=large-v3
TRANSCRIPTION_MODEL_REVISION=edaa852ec7e145841d8ffdb056a99866b5f0a478
TRANSCRIPTION_MODEL_CACHE_DIR=E:\直播间切片工作流存储\_模型\faster-whisper
TRANSCRIPTION_LOCAL_FILES_ONLY=true
TRANSCRIPTION_LANGUAGE=zh
TRANSCRIPTION_DEVICE=cuda
TRANSCRIPTION_COMPUTE_TYPE=float16
TRANSCRIPTION_CPU_FALLBACK_MODEL=medium
TRANSCRIPTION_CHUNK_SECONDS=120
TRANSCRIPTION_CHUNK_OVERLAP_SECONDS=5


# ========================
# 排期与 Windows Chrome Worker
# ========================

PUBLISH_SCHEDULER_ENABLED=true
PUBLISH_SCHEDULER_INTERVAL_SECONDS=5
PUBLISH_DEFAULT_MODE=local_browser
PUBLISH_JOB_STALE_MINUTES=30
PUBLISH_SCHEDULER_MAX_RETRY_COUNT=3
PUBLISH_SCHEDULER_EXPORT_DIR=
PUBLISH_SCHEDULER_ALLOW_PUBLISH_WITHOUT_REVIEW=false
PUBLISH_ENABLE_OPENCLI_FALLBACK=false

# setup.ps1 / start_publish_worker.ps1 会自动生成随机值。
PUBLISH_WORKER_TOKEN=
PUBLISH_WORKER_URL=http://host.docker.internal:8765
PUBLISH_WORKER_TIMEOUT_SECONDS=1800
PUBLISH_BROWSER_CHANNEL=chrome
PUBLISH_BROWSER_HEADLESS=false
PUBLISH_BROWSER_NAVIGATION_TIMEOUT_MS=60000
PUBLISH_BROWSER_FAILURE_HOLD_SECONDS=600
PUBLISH_BROWSER_PROFILE_DIR=
PUBLISH_BROWSER_ARTIFACT_DIR=
PUBLISH_WORKER_STATE_DIR=

# 留空时自动使用当前仓库目录，不要写入其他人的用户名或固定电脑路径。
PUBLISH_HOST_PROJECT_ROOT=
PUBLISH_WORKER_ALLOWED_ROOTS=

# 旧 opencli 兼容配置，默认关闭。
OPENCLI_LOCAL_BASE_URL=http://127.0.0.1:8001
OPENCLI_HOST_BRIDGE_URL=http://host.docker.internal:8765

# ========================
# 安全与运行限制
# ========================

AI_NETWORK_ACCESS=enabled
AI_WINDOWS_WSL_SETUP_ACKNOWLEDGED=true
AI_MODEL_CONTEXT_WINDOW=1000000
AI_MODEL_AUTO_COMPACT_TOKEN_LIMIT=900000

# 允许浏览的媒体根目录，多个绝对路径用逗号分隔；留空时使用项目配置目录。
ALLOWED_MEDIA_ROOTS=
MAX_UPLOAD_SIZE_BYTES=4294967296
ALLOWED_UPLOAD_EXTENSIONS=.mp4,.mov,.mkv,.avi,.flv,.webm,.m4v,.ts,.wav,.mp3,.aac,.flac,.ogg,.wma

FFMPEG_AUDIO_EXTRACT_TIMEOUT=600
FFMPEG_CUT_TIMEOUT=600
FFMPEG_SUBTITLE_TIMEOUT=300
FFMPEG_COVER_TIMEOUT=120
FFPROBE_TIMEOUT=60
FFMPEG_CHUNK_TIMEOUT=120

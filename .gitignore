.venv/
.venv.before-path-rename-*/
__pycache__/
*.pyc

# 本地真实配置与密钥：不要提交 API Key
.env
.env.*
!.env.example

data/*
!data/.gitkeep

# 通用视频目录与隔离 Demo 数据
workspace/
demo-data/

# 本地备份、验收报告与恢复临时文件（可能包含设备信息或密钥）
backups/
acceptance-results/
*.partial-*
*.restore-new-*
*.restore-old-*

# 发布浏览器登录态、执行日志和失败截图（只允许保存在本机）
data/browser_profiles/
data/publish_worker/
data/publish_artifacts/
outputs/publish_packages/
playwright/.auth/
*.storage-state.json
cookies*.json

tasks/*
!tasks/.gitkeep

# 本地生成物与大文件
*.log
*.sqlite
*.sqlite3
*.db
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.mp3
*.wav

.DS_Store
Thumbs.db

